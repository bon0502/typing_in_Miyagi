<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <h1 class="text-xl font-bold">プロフィール</h1>

      <dl class="space-y-3">
        <div class="flex justify-between border-b pb-2">
          <dt class="text-gray-500">ニックネーム</dt>
          <dd class="text-gray-800 font-medium"><%= @user.nickname %></dd>
        </div>
        <div class="flex justify-between border-b pb-2">
          <dt class="text-gray-500">メールアドレス</dt>
          <dd class="text-gray-800 font-medium"><%= @user.email %></dd>
        </div>
      </dl>
      <div class="mt-6 text-center">
        <%= link_to '編集する', edit_user_setting_path, class:"bg-emerald-500 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline"  %>
      </div>

      <h1 class="text-xl font-bold mt-10">ベストスコア</h1>
      <% if @best_score.present? %>
        <dl class="space-y-3">
          <% @best_score.each do |score| %>
            <div class="flex justify-between border-b pb-2">
              <dt class="text-gray-500"><%= score.course_name %></dt>
              <dd class="text-gray-800 font-medium"><%= score.best_score %>点</dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="text-gray-500">スコアがありません。</p>
      <% end %>
    </div>
  </div>
</div>
