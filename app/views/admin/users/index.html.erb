<div class="container mt-4">
  <h1>登録者一覧</h1>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>ニックネーム</th>
        <th>メールアドレス</th>
        <th>登録日</th>
        <th>管理者権限</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.nickname %></td>
          <td><%= user.email %></td>
          <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
          <td><%= user.admin? ? '管理者' : '一般' %></td>
          <td>
            <%= link_to 'パスワード変更', edit_admin_user_path(user), class: 'btn btn-sm btn-primary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
