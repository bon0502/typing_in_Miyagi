<div class="container mt-4">
  <h1><%= @course.name %></h1>

  <div class="mb-3">
    <%= link_to "問題を追加", new_admin_course_typing_question_path(@course), class: "btn btn-primary" %>
    <%= link_to "コース一覧に戻る", admin_courses_path, class: "btn btn-secondary" %>
  </div>

  <h2 class="mt-4">問題一覧 (<%= @typing_questions.count %>問)</h2>

  <% if @typing_questions.present? %>
    <table class="w-full border-collapse border border-gray-300">
      <thead>
        <tr class="bg-gray-200">
          <th class="border border-gray-300 p-2">No.</th>
          <th class="border border-gray-300 p-2">問題文</th>
          <th class="border border-gray-300 p-2">答え</th>
          <th class="border border-gray-300 p-2">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @typing_questions.each_with_index do |question, index| %>
          <tr class="<%= index.even? ? 'bg-gray-100' : '' %>">
            <td class="border border-gray-300 p-2"><%= index + 1 %></td>
            <td class="border border-gray-300 p-2"><%= question.question_text %></td>
            <td class="border border-gray-300 p-2">
              <% if question.typing_answers.any? %>
                <ul>
                  <% question.typing_answers.each do |answer| %>
                    <li>
                      <%= answer.answer_text %>
                      <%= link_to '削除', admin_course_typing_question_typing_answer_path(@course, question, answer), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: 'btn btn-sm btn-danger' %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <span class="text-muted">答えがありません</span>
              <% end %>
              <%= link_to '答えを追加', new_admin_course_typing_question_typing_answer_path(@course, question), class: 'btn btn-sm btn-success' %>
            </td>
            <td class="border border-gray-300 p-2">
              <%= link_to '編集', edit_admin_course_typing_question_path(@course, question), class: 'btn btn-sm btn-warning' %>
              <%= link_to '削除', admin_course_typing_question_path(@course, question), data: { turbo_method: :delete, turbo_confirm: '本当に削除しますか？' }, class: 'btn btn-sm btn-danger' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-muted">まだ問題が登録されていません。</p>
  <% end %>
</div>
