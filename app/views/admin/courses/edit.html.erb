<div class="container mt-5">
  <h1>コースを編集</h1>

  <%= form_with model: [:admin, @course], local: true do |f| %>
    <div class="mb-3">
      <%= f.label :name, 'コース名' %>
      <%= f.text_field :name, class: 'form-control' %>
    </div>

    <%= f.submit '更新', class: 'btn btn-primary' %>
  <% end %>

  <%= link_to '戻る', admin_courses_path, class: 'btn btn-secondary mt-3' %>
</div>
