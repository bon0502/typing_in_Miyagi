<%= form_with model: [:admin, course], local: true do |f| %>
  <% if course.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h4>
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, 'コース名', class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', placeholder: '例: 🗣 方言コース' %>
  </div>

  <div class="mb-3">
    <%= f.submit class: 'btn btn-primary' %>
    <%= link_to 'キャンセル', admin_courses_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
