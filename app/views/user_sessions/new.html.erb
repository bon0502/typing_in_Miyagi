<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <div class="text-emerald-900 text-3xl font-bold mb-6">ログイン</div>
        <%= form_with url: login_path, local: false do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.email_field :email, name: 'email', class: "shadow appearance-none border px-3 py-2 focus:outlline-none focus:ring-2 focus:ring-blue-500 rounded" %>
          </div>
          <div class="mb-3">
            <%= f.label :password, class: "block text-gray-700 text-sm font-bold mb-2" %>
            <%= f.password_field :password, name: 'password', class: "shadow appearance-none border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"  %>
          </div>
          <%= f.submit "ログイン", class: "bg-emerald-500 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline mt-3 mb-3 cursor-pointer" %>
        <% end %>
          <%= button_to "/auth/google_oauth2", class: "gsi-material-button", data: { turbo: false } do %>
            <div class="gsi-material-button-state"></div>
            <div class="gsi-material-button-content-wrapper">
              <div class="gsi-material-button-icon">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" style="display: block;">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                  <path fill="none" d="M0 0h48v48H0z"></path>
                </svg>
              </div>
              <span class="gsi-material-button-contents">Googleでログイン</span>
              <span style="display: none;">Googleでログイン</span>
            </div>
          <% end %>
        <div class='text-center mt-4'>
          <%= link_to "ユーザー登録はこちら", new_user_path, class: "text-blue-500 hover:text-blue-700 underline" %>
          <%= link_to "パスワードを忘れた方はこちら", "#", class: "text-blue-500 hover:text-blue-700 underline" %>
        </div>
      </div>
    </div>
  </div>
</div>
